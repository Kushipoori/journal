{
  "expo": {
    "name": "Journal",
    "slug": "journal",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "journal",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.kushal.journal",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Journal turns your voice into text for your entries.",
        "NSMicrophoneUsageDescription": "Journal listens while you speak so it can write your entry for you."
      }
    },
    "android": {
      "package": "dev.kushal.journal",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#F7F2E8"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F7F3EE",
          "dark": {
            "image": "./assets/images/splash.png",
            "backgroundColor": "#141110"
          }
        }
      ],
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Journal records your voice entries and audio clips."
        }
      ],
      "expo-video",
      "expo-sqlite",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Journal attaches photos and videos you pick to your entries.",
          "cameraPermission": "Journal uses the camera to take photos and record videos for your entries.",
          "microphonePermission": "Journal records sound with your videos."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Journal listens while you speak so it can write your entry for you.",
          "speechRecognitionPermission": "Journal turns your voice into text for your entries.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "054bc76e-f3eb-49be-aa50-d5daafbcb91e"
      }
    }
  }
}
